<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetLar.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PetLar.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-md petlar-navbar">
            <div class="container">
                <a class="petlar-brand" asp-controller="Home" asp-action="Index" aria-label="PetLar - página inicial">
                    <span class="petlar-brand-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 10 9-7 9 7" />
                            <path d="M5 9.5V21h14V9.5" />
                            <circle cx="9" cy="12" r="1" fill="currentColor" stroke="none" />
                            <circle cx="12" cy="10.5" r="1" fill="currentColor" stroke="none" />
                            <circle cx="15" cy="12" r="1" fill="currentColor" stroke="none" />
                            <path d="M12 13c-2 0-3.25 1.3-3 3.1.12.95.9 1.55 1.8 1.55h2.4c.9 0 1.68-.6 1.8-1.55C15.25 14.3 14 13 12 13Z" fill="currentColor" stroke="none" />
                        </svg>
                    </span>
                    <span>PetLar</span>
                </a>

                <button class="navbar-toggler petlar-navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#petlarNavbar" aria-controls="petlarNavbar"
                        aria-expanded="false" aria-label="Abrir menu de navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="petlarNavbar">
                    <ul class="navbar-nav petlar-nav-links mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="">Como funciona</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="">Pets para adoção</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="" asp-action="">Para ONGs</a>
                        </li>
                    </ul>

                    <div class="petlar-nav-actions gap-4">
                        <a class="btn btn-petlar-ngo">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                            Área da ONG
                        </a>
                        <a class="btn btn-petlar-coral btn-md">Adote</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="petlar-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-5">
                    <a class="petlar-footer-brand" asp-area="" asp-controller="" asp-action="" aria-label="PetLar - página inicial">
                        <span class="petlar-brand-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 10 9-7 9 7" />
                            <path d="M5 9.5V21h14V9.5" />
                            <circle cx="9" cy="12" r="1" fill="currentColor" stroke="none" />
                            <circle cx="12" cy="10.5" r="1" fill="currentColor" stroke="none" />
                            <circle cx="15" cy="12" r="1" fill="currentColor" stroke="none" />
                            <path d="M12 13c-2 0-3.25 1.3-3 3.1.12.95.9 1.55 1.8 1.55h2.4c.9 0 1.68-.6 1.8-1.55C15.25 14.3 14 13 12 13Z" fill="currentColor" stroke="none" />
                        </svg>
                        </span>
                        <span>PetLar</span>
                    </a>
                    <p class="petlar-footer-description">
                        Conectando corações e patinhas.<br>Cada adoção transforma duas vidas.
                    </p>
                </div>

                <div class="col-6 col-md-3">
                    <nav aria-label="Links do rodapé">
                        <h2 class="petlar-footer-title">Plataforma</h2>
                        <ul class="petlar-footer-links">
                            <li><a asp-area="" asp-controller="" asp-action="">Como funciona</a></li>
                            <li><a asp-area="" asp-controller="" asp-action="">Pets para adoção</a></li>
                            <li><a asp-area="" asp-controller="" asp-action="">Para ONGs</a></li>
                        </ul>
                    </nav>
                </div>

                <div class="col-6 col-md-3">
                    <nav aria-label="Links legais">
                        <h2 class="petlar-footer-title">Legal</h2>
                        <ul class="petlar-footer-links">
                            <li><a asp-area="" asp-controller="" asp-action="">Privacidade</a></li>
                            <li><a asp-area="" asp-controller="" asp-action="">Termos de uso</a></li>
                            <li><a asp-area="" asp-controller="" asp-action="">Contato</a></li>
                        </ul>
                    </nav>
                </div>
            </div>

            <div class="petlar-footer-bottom">
                <small>© 2026 PetLar. Todos os direitos reservados.</small>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
