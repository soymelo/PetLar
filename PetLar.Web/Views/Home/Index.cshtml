@model PetLar.Web.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<section class="petlar-home-hero py-5" aria-labelledby="home-title">
    <div class="row align-items-center g-5">
        <div class="col-12 col-lg-6">
            <div class="d-flex flex-column align-items-start">
                <p class="petlar-home-eyebrow">
                    <span class="petlar-home-eyebrow-icon" aria-hidden="true">♥</span>
                    @Model.AvailablePetsCount pets esperando por um lar
                </p>
                <h1 id="home-title" class="petlar-home-heading fw-bold">
                    Todo pet merece um lar
                    <span class="petlar-home-title">cheio de amor.</span>
                </h1>
                <p class="petlar-home-description">
                    Encontre cães e gatos esperando por uma nova família perto de você. Adoção simples, responsável e cheia de carinho.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-petlar-coral btn-lg" asp-controller="" asp-action="">Encontrar um pet</a>
                    <a class="btn btn-petlar-outline btn-lg" asp-controller="" asp-action="">Sou uma ONG</a>
                </div>
                <div class="row row-cols-3 g-3 petlar-home-stats" aria-label="Números do PetLar">
                    <div class="col">
                        <strong>@Model.CompletedAdoptionsCount</strong>
                        <span>Adoções realizadas</span>
                    </div>
                    <div class="col">
                        <strong>@Model.OngsCount</strong>
                        <span>ONGs parceiras</span>
                    </div>
                    <div class="col">
                        <strong>@Model.AvailablePetsCount</strong>
                        <span>Pets disponíveis</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="petlar-home-image">
                <img src="~/images/petlar-home-hero.webp" alt="Imagem de uma pessoa com cachorros e gatos." class="img-fluid" />
                <div class="petlar-adoption-card">
                    <div class="petlar-adoption-thumbnail">
                        <img src="~/images/petlar-luna-image1.webp" />
                    </div>
                    <div class="petlar-adoption-content">
                        <strong>Luna foi adotada!</strong>
                        <span>São Paulo — SP · há 2 horas</span>
                    </div>
                    <span class="petlar-adoption-heart" aria-hidden="true">♥</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="petlar-available-pets py-5" aria-labelledby="available-pets-title">
    <div class="petlar-available-pets-header">
        <p class="petlar-available-pets-eyebrow">Encontre seu novo amigo</p>
        <h2 id="available-pets-title">Pets esperando por você</h2>
        <p>Cada adoção transforma duas vidas.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        <div class="col">
            <article class="petlar-pet-card">
                <div class="petlar-pet-card-image">
                    <img src="~/images/petlar-luna-image1.webp" alt="Thor, cão disponível para adoção" />
                    <span class="petlar-pet-card-tag petlar-pet-card-species">Cão</span>
                    <span class="petlar-pet-card-tag petlar-pet-card-availability">Disponível</span>
                </div>
                <div class="petlar-pet-card-body">
                    <h3>Thor</h3>
                    <p class="petlar-pet-card-meta">2 anos <span aria-hidden="true">•</span> Médio <span aria-hidden="true">•</span> Macho</p>
                    <p class="petlar-pet-card-location">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                            <circle cx="12" cy="10" r="3" />
                        </svg>
                        São Paulo — SP
                    </p>
                </div>
            </article>
        </div>
        <div class="col">
            <article class="petlar-pet-card">
                <div class="petlar-pet-card-image">
                    <img src="~/images/petlar-luna-image1.webp" alt="Mel, gata disponível para adoção" />
                    <span class="petlar-pet-card-tag petlar-pet-card-species">Gato</span>
                    <span class="petlar-pet-card-tag petlar-pet-card-availability">Disponível</span>
                </div>
                <div class="petlar-pet-card-body">
                    <h3>Mel</h3>
                    <p class="petlar-pet-card-meta">1 ano <span aria-hidden="true">•</span> Pequeno <span aria-hidden="true">•</span> Fêmea</p>
                    <p class="petlar-pet-card-location">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                            <circle cx="12" cy="10" r="3" />
                        </svg>
                        Campinas — SP
                    </p>
                </div>
            </article>
        </div>
        <div class="col">
            <article class="petlar-pet-card">
                <div class="petlar-pet-card-image">
                    <img src="~/images/petlar-luna-image1.webp" alt="Bento, cão disponível para adoção" />
                    <span class="petlar-pet-card-tag petlar-pet-card-species">Cão</span>
                    <span class="petlar-pet-card-tag petlar-pet-card-availability">Disponível</span>
                </div>
                <div class="petlar-pet-card-body">
                    <h3>Bento</h3>
                    <p class="petlar-pet-card-meta">4 anos <span aria-hidden="true">•</span> Grande <span aria-hidden="true">•</span> Macho</p>
                    <p class="petlar-pet-card-location">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                            <circle cx="12" cy="10" r="3" />
                        </svg>
                        Santos — SP
                    </p>
                </div>
            </article>
        </div>
        <div class="col">
            <article class="petlar-pet-card">
                <div class="petlar-pet-card-image">
                    <img src="~/images/petlar-luna-image1.webp" alt="Lola, gata disponível para adoção" />
                    <span class="petlar-pet-card-tag petlar-pet-card-species">Gato</span>
                    <span class="petlar-pet-card-tag petlar-pet-card-availability">Disponível</span>
                </div>
                <div class="petlar-pet-card-body">
                    <h3>Lola</h3>
                    <p class="petlar-pet-card-meta">3 anos <span aria-hidden="true">•</span> Médio <span aria-hidden="true">•</span> Fêmea</p>
                    <p class="petlar-pet-card-location">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                            <circle cx="12" cy="10" r="3" />
                        </svg>
                        Guarulhos — SP
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>
